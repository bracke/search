with "config/search_tests_config.gpr";
with "../search.gpr";
with "../../project_tools/project_tools.gpr";

project Search_Tests is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Search_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("run_tests.adb", "search_release_check.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Search_Tests_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;

   package Linker is
      --  search pulls in httpclient (via versionlib), whose TLS bridge needs
      --  OpenSSL; the test runner links the engine, so it needs these too.
      case Search_Tests_Config.Alire_Host_OS is
         when "windows" =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto", "-lws2_32", "-lcrypt32");
         when others =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto");
      end case;
   end Linker;

   package Builder is
      for Executable ("run_tests.adb") use "search_tests";
   end Builder;
end Search_Tests;
