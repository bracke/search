default_locale = en
en.app.name = "search"
en.command.search = "Search"
en.command.cancel = "Cancel"
en.command.save_search = "Save Search"
en.command.export = "Export"
en.command.open = "Open"
en.command.reveal = "Reveal"
en.command.toggle_filters = "Toggle Filters"
