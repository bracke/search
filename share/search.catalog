en.view.small_icons = "Small Icons"
en.view.large_icons = "Large Icons"
en.view.details = "Details"
en.panel.metadata = "Filesystem Metadata"
en.panel.summary = "Search Summary"
en.cli.usage = "Usage: search ROOT PATTERN"
en.cli.summary = "Lists the files and folders under ROOT whose name, path below ROOT or content matches PATTERN."
en.diagnostic.query.roots.missing = "At least one search root is required."
en.diagnostic.query.pattern.empty = "A search pattern is required."
en.diagnostic.query.root.not_found = "The search root does not exist."
en.diagnostic.query.regex.invalid = "The regular expression is invalid."
en.diagnostic.query.max_file_size.invalid = "The maximum file size cannot be negative."
en.diagnostic.content.file.missing = "The file changed before it could be scanned."
en.diagnostic.content.file.too_large = "The file is larger than the maximum file size, so its content was not searched."
en.diagnostic.content.file.unreadable = "The file could not be read, so its content was not searched."
en.diagnostic.traversal.entry.failed = "A filesystem entry could not be inspected."
en.diagnostic.traversal.root.failed = "The search root could not be read."
