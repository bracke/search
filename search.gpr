with "config/search_config.gpr";
with "../files/files.gpr";
with "../guikit/guikit.gpr";
with "../i18n/i18n.gpr";
with "../messages/messages.gpr";
with "../regexp/regexp.gpr";
with "../versionlib/versionlib.gpr";

project Search is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Search_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("search-main.adb", "search-desktop.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Search_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case Search_Config.Alire_Host_OS is
         when "macos" =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-lssl", "-lcrypto",
               "-framework", "CoreFoundation", "-framework", "CoreServices",
               "-framework", "Foundation");
         when "windows" =>
            for Default_Switches ("Ada") use
              ("-lvulkan-1", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-lssl", "-lcrypto", "-lws2_32", "-lcrypt32",
               "-lshell32", "-lole32", "-lkernel32");
         when others =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-lssl", "-lcrypto");
      end case;
   end Linker;

   package Builder is
      for Executable ("search-main.adb") use "search";
      for Executable ("search-desktop.adb") use "search-desktop";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Search;
